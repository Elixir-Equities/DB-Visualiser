# ── Frontend ──────────────────────────────────────────────────────────────────
# nginx proxies /api/ to this URL.
# In a single-container setup this stays as-is (backend shares the container).
BACKEND_URL=http://localhost:8000

# ── Backend — Application ─────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Backend — ScyllaDB connection ─────────────────────────────────────────────
# Comma-separated list of contact point IPs or hostnames
SCYLLA_CONTACT_POINTS=127.0.0.1
SCYLLA_PORT=9042

# Leave blank to connect without authentication
SCYLLA_USERNAME=
SCYLLA_PASSWORD=

# Set to true to enable SSL/TLS
SCYLLA_SSL=false

# CA certificate — choose ONE of the two options below:
#
# Option A (recommended): path to a PEM file mounted into the container.
#   docker run --env-file .env -v /path/to/ca.pem:/certs/ca.pem ...
SCYLLA_CA_CERT_FILE=
#
# Option B: inline PEM content with literal \n (no real newlines — Docker
#   --env-file does not support multi-line values).
#   SCYLLA_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIB...\n-----END CERTIFICATE-----"
SCYLLA_CA_CERT=
