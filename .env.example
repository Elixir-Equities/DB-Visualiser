# ── Frontend ──────────────────────────────────────────────────────────────────
# nginx proxies /api/ to this URL.
# In a single-container setup this stays as-is (backend shares the container).
BACKEND_URL=http://localhost:8000

# ── Backend — Application ─────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Backend — ScyllaDB connection ─────────────────────────────────────────────
# Comma-separated list of contact point IPs or hostnames
SCYLLA_CONTACT_POINTS=127.0.0.1
SCYLLA_PORT=9042

# Leave blank to connect without authentication
SCYLLA_USERNAME=
SCYLLA_PASSWORD=

# Set to true to enable SSL/TLS
SCYLLA_SSL=false

# Path to the CA cert inside the container — do not change this value.
# To use SSL: place cert.pem in the project root before running docker build.
SCYLLA_CA_CERT_FILE=/certs/ca.pem
