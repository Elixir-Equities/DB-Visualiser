# ── Sub-portal auth (see PORTAL_AUTH_INTEGRATION.md) ─────────────────────────
# Vite inlines every VITE_* value into the bundle AT BUILD TIME. `npm run dev`
# reads this file live, but a built bundle freezes it — editing this file under
# `preview` or a deployed build does nothing. Never put a secret in a VITE_*
# var that will be built for deployment.

# Mode switch. Only the exact word `local` (and only on a real localhost host)
# opts into local mode. Empty or anything else = the secure gateway path.
VITE_APP_ENV=

# ── Gateway mode (deployed: test / prod) ──────────────────────────────────────
# Exact parent origin — scheme + host + port, NO trailing slash. A mismatch is
# the #1 bug: postMessage is silently dropped and the token never arrives.
# Running the parent locally? Use http://localhost:3000 and rebuild.
VITE_PARENT_ORIGIN=https://portal.paisasmart.com

# Gateway host for REST, and this portal's route on it.
VITE_MIDDLEWARE_BASE_URL=https://test-portal-gateway.paisasmart.com
VITE_SCYLLA_VISUALIZER_GATEWAY=scylla-visualizer

# Gateway host for WebSockets — the gateway's own host, since it exposes
# /ws/{route}/... and swaps the token for INTERNAL_API_TOKEN before proxying.
VITE_GATEWAY_WS_URL=wss://test-portal-gateway.paisasmart.com

# ── Local mode (developer machine only — never built for deployment) ──────────
# Backend called directly, no parent handshake and no gateway.
VITE_LOCAL_API_URL=http://localhost:8000
VITE_LOCAL_WS_URL=ws://localhost:8000

# Sent as the X-Api-Key header. Must equal the backend's INTERNAL_API_TOKEN.
# In gateway mode the gateway supplies this instead and the browser never sees it.
VITE_LOCAL_API_KEY=
