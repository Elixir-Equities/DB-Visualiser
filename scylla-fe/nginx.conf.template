server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # The app may ONLY be embedded in an iframe by the portal. Any other site's
    # iframe — and top-level framing attacks — are blocked by the browser.
    # (Do NOT add X-Frame-Options: SAMEORIGIN; it would block the portal iframe.
    #  frame-ancestors is the modern, per-origin replacement.)
    add_header Content-Security-Policy "frame-ancestors https://portal.paisasmart.com" always;

    # SPA — always fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Port 80 is the only published port (see the README run command), so the
    # middleware gateway reaches the backend through here. Requests arrive
    # server-to-server from the gateway, already carrying the X-API-Key it
    # attached after verifying the caller's Firebase token — they are simply
    # forwarded on.
    #
    # Two things this block deliberately does NOT do:
    #   * No X-API-Key injection. nginx adding the key would let anyone call
    #     this origin directly and reach the backend with no Firebase token,
    #     bypassing the gateway. Without it, an unauthenticated call still
    #     gets a 401 from the backend, which stays the real gate.
    #   * No Sec-Fetch-Site / Origin gate. Those headers are set by browsers;
    #     the gateway's server-side request carries neither, so such a gate
    #     would 403 every legitimate call.
    location /api/ {
        proxy_pass          ${BACKEND_URL}/api/;
        proxy_http_version  1.1;
        proxy_set_header    Host              $host;
        proxy_set_header    X-Real-IP         $remote_addr;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
        proxy_read_timeout  30s;
    }
}
