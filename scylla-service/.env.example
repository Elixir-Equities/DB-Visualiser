# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Shared secret required as the X-API-Key header on every /api/v1 request.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# ScyllaDB connection
# Comma-separated list of contact point IPs or hostnames
SCYLLA_CONTACT_POINTS=127.0.0.1
SCYLLA_PORT=9042

# Leave blank to connect without authentication
SCYLLA_USERNAME=
SCYLLA_PASSWORD=

# Set to true to enable SSL/TLS
SCYLLA_SSL=false
# PEM-encoded CA certificate content (required when SCYLLA_SSL=true).
# Paste the full cert inline, replacing literal newlines with \n:
# SCYLLA_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIB...\n-----END CERTIFICATE-----"
SCYLLA_CA_CERT=

# Comma-separated physical keyspaces that use the PFR masking policy.
# Configure this as a GitHub Actions environment/repository variable in deployments.
PFR_MASKED_KEYSPACES=pfr_aa_integration
